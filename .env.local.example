# Same Supabase project as your storefront + admin
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only key for catalogue-session writes (never exposed to browser)
# Get this from Supabase Dashboard → Project Settings → API → service_role key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Where "Buy Now" links open (your storefront)
NEXT_PUBLIC_STOREFRONT_URL=https://your-storefront.vercel.app

# Your WhatsApp number — digits only, with country code, no + or spaces
NEXT_PUBLIC_WHATSAPP_NUMBER=919999999999

# This app's own URL (for og:url meta)
NEXT_PUBLIC_CATALOGUE_URL=https://your-catalogue.vercel.app

# Static fallback for the browser tab title and PWA manifest (real value comes from admin site_config)
NEXT_PUBLIC_BRAND_NAME=Your Brand Name

# Image URL used for WhatsApp/iMessage link previews (og:image)
NEXT_PUBLIC_OG_IMAGE=https://your-cdn.com/og-image.jpg
